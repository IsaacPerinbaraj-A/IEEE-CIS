{
  "name": "ieee-cis",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "shared",
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend --",
    "build": "tsc -b && npm run build -w frontend",
    "preview": "npm run preview -w frontend --",
    "server": "npm run start -w backend",
    "lint": "eslint .",
    "test": "node --test \"shared/**/*.test.ts\" \"backend/**/*.test.ts\" \"frontend/scripts/**/*.test.ts\"",
    "test:server": "npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^22.20.2",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1"
  }
}
