# Settings for the admin server on your computer (`npm run server`).
# Copy this file to .env.local (never committed) and fill in the values. Placeholders only: never put real
# values in this file. None of these may start with VITE_ (that would put them in the public website).

# MongoDB Atlas connection string for the cis database (docs/SETUP.md, "Connection string").
# Leave empty to run the server without a database: routes that need it answer 503.
MONGODB_URI=
MONGODB_DB=cis

# The address the website runs on locally (`npm run dev` uses port 5175 in this project's launch settings).
SITE_ORIGIN=http://localhost:5175
PORT=8787

# Random secrets of at least 32 characters. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EXPORT_TOKEN=
IP_HASH_KEY=
# One-time token for creating the first owner. Remove it once the owner account exists.
SETUP_TOKEN=

# Vercel Deploy Hook. Leave empty locally: publishing then saves releases without rebuilding the site.
DEPLOY_HOOK_URL=

# Build only (set in Vercel, not here). Leave them unset on your computer so `npm run build` uses frontend/src/data.
# CONTENT_EXPORT_URL=https://REPLACE-WITH-RENDER-SERVICE.onrender.com/api/export/published
# CONTENT_EXPORT_TOKEN=
